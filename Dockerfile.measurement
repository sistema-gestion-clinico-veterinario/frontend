# Imagen de medición: compila exactamente el frontend optimizado, pero dirige
# las integraciones a la red local del escenario y nunca a producción.
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build -- --configuration measurement

FROM nginx:1.27-alpine
COPY nginx.measurement.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/vetsystem-frontend/browser /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=12 \
  CMD wget -q -O - http://127.0.0.1/healthz || exit 1
